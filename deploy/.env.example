# Copy to deploy/.env (gitignored) and fill in.

# Funnel (public) address of the hub; Claude's connector URL is this + /mcp
PUBLIC_BASE_URL=https://worldsmith.YOUR-TAILNET.ts.net
# Tailnet-only portal address
PORTAL_URL=https://worldsmith.YOUR-TAILNET.ts.net:8443
# Only this Tailscale login can open the portal
OWNER_LOGIN=you@example.com
OWNER_NAME=You

# Where the featured world answers status pings (Phase 0: the spike world on the host)
WORLD_STATUS_TARGET=host.docker.internal:25601

# Shared secret between hub and worker (generate: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))")
WORKER_TOKEN=
# playit.gg Docker agent secret (playit.gg → Agents → Add agent → Docker)
PLAYIT_SECRET=

# Your Minecraft Java username (always approved, always operator)
OWNER_MC_USERNAME=

# Shared Geyser/Floodgate secret: 16 random bytes, base64 (node -e "console.log(require('crypto').randomBytes(16).toString('base64'))")
FLOODGATE_KEY_B64=
